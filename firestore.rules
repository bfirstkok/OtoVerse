rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/account_controls/$(request.auth.uid))
          || get(/databases/$(database)/documents/account_controls/$(request.auth.uid)).data.status != 'suspended'
          || (get(/databases/$(database)/documents/account_controls/$(request.auth.uid)).data.until is timestamp
            && get(/databases/$(database)/documents/account_controls/$(request.auth.uid)).data.until <= request.time));
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }

    function isChatParticipant(chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
    }

    function roomDoc(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function roomExists(roomId) {
      return exists(roomDoc(roomId));
    }

    function roomData(roomId) {
      return get(roomDoc(roomId)).data;
    }

    function isRoomHost(roomId) {
      return isSignedIn() && roomExists(roomId) && roomData(roomId).hostUid == request.auth.uid;
    }

    function isRoomMember(roomId) {
      return isSignedIn() && (
        isRoomHost(roomId)
        || exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid))
      );
    }

    function validControl(uid) {
      let data = request.resource.data;
      let audit = getAfter(/databases/$(database)/documents/admin_audit/$(data.lastActionId)).data;
      return uid != request.auth.uid
        && (!exists(/databases/$(database)/documents/admins/$(uid))
          || get(/databases/$(database)/documents/admins/$(uid)).data.role != 'admin')
        && data.keys().hasOnly(['status','reason','until','updatedAt','updatedBy','lastActionId'])
        && data.status in ['active','suspended']
        && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 500
        && (data.until == null || (data.until is timestamp && data.until > request.time))
        && (data.status != 'active' || data.until == null)
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time
        && audit.actorUid == request.auth.uid && audit.targetUid == uid
        && audit.status == data.status && audit.reason == data.reason
        && audit.until == data.until && audit.createdAt == request.time;
    }

    match /account_controls/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validControl(uid);
      allow delete: if false;
    }

    match /admin_audit/{eventId} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 1000
        && request.resource.data.targetUid is string
        && ((request.resource.data.action in ['suspend','restore']
          && request.resource.data.keys().hasOnly(['action','targetUid','actorUid','reason','until','previousStatus','status','createdAt'])
          && request.resource.data.action == (request.resource.data.status == 'suspended' ? 'suspend' : 'restore')
          && getAfter(/databases/$(database)/documents/account_controls/$(request.resource.data.targetUid)).data.lastActionId == eventId
          && getAfter(/databases/$(database)/documents/account_controls/$(request.resource.data.targetUid)).data.updatedAt == request.time)
        || (request.resource.data.action == 'review_report'
          && request.resource.data.keys().hasOnly(['action','reportId','targetUid','actorUid','reason','status','createdAt'])
          && request.resource.data.targetUid == (getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.get('uid','') == null ? '' : getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.get('uid',''))
          && getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.lastActionId == eventId
          && getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.reviewedAt == request.time));
    }

    match /user_activity/{eventId} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid','action','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.action in ['session_started','report_submitted','song_suggested']
        && request.resource.data.createdAt == request.time;
    }

    // Admin membership. Users may read only their own role; an existing admin
    // may manage additional admin documents.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Catalog includes active and inactive songs; only admins may edit them.
    // Admins can read and manage every item.
    match /animeSongs/{songId} {
      allow read: if resource.data.isActive in [true, false] || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // profiles
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // per-user private data (favorites, local stats, etc.)
    match /user_private/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // AI requests use the caller's token; clients cannot reset their quota.
    match /ai_chat_usage/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['count', 'windowStart', 'updatedAt'])
        && request.resource.data.count == 1
        && request.resource.data.windowStart == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['count', 'windowStart', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.windowStart == resource.data.windowStart
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= 60
          && request.time >= resource.data.updatedAt + duration.value(5, 's'))
        || (request.time >= resource.data.windowStart + duration.value(24, 'h')
          && request.resource.data.count == 1
          && request.resource.data.windowStart == request.time));
    }

    // chats
    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && (request.auth.uid in request.resource.data.participants)
        && chatId == (request.resource.data.participants[0] + "__" + request.resource.data.participants[1]);

      // allow updating meta/lastMessage/etc but do NOT allow changing participants
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.participants)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read: if isChatParticipant(chatId);

      allow create: if isChatParticipant(chatId)
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000;

      allow update, delete: if false;
    }

    // song requests
    match /song_requests/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.requestText is string
        && request.resource.data.requestText.size() > 0
        && request.resource.data.requestText.size() <= 220;

      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Reports retain their original reporter and content. Review is audited atomically.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending')
        && !request.resource.data.keys().hasAny(['adminNote','reviewedBy','reviewedAt','lastActionId']);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNote','reviewedAt','reviewedBy','lastActionId'])
        && request.resource.data.status in ['pending','investigating','resolved','rejected']
        && request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 1000
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && getAfter(/databases/$(database)/documents/admin_audit/$(request.resource.data.lastActionId)).data.reportId == reportId
        && getAfter(/databases/$(database)/documents/admin_audit/$(request.resource.data.lastActionId)).data.actorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/admin_audit/$(request.resource.data.lastActionId)).data.status == request.resource.data.status
        && getAfter(/databases/$(database)/documents/admin_audit/$(request.resource.data.lastActionId)).data.reason == request.resource.data.adminNote
        && getAfter(/databases/$(database)/documents/admin_audit/$(request.resource.data.lastActionId)).data.createdAt == request.time;
      allow delete: if false;
    }

    // online rooms
    match /rooms/{roomId} {
      // Public room list shows only listed lobby rooms.
      allow list: if isSignedIn() && resource.data.isListed == true && resource.data.status == "lobby";

      // Allow opening a room doc if it's listed OR you're already a member OR it's a lobby room you know the id for.
      allow get: if isSignedIn() && (
        resource.data.isListed == true
        || isRoomMember(roomId)
        || resource.data.status == "lobby"
      );

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == "lobby"
        && request.resource.data.roomName is string
        && request.resource.data.roomName.size() > 0
        && request.resource.data.roomName.size() <= 40
        && request.resource.data.hostNickname is string
        && request.resource.data.hostNickname.size() > 0
        && request.resource.data.hostNickname.size() <= 14
        && request.resource.data.gameMode is string
        && request.resource.data.gameMode in ["standard", "battle_royale"]
        && request.resource.data.answerMode is string
        && request.resource.data.questionCount is int
        && request.resource.data.perQuestionMs is int;

      // Host can update anything; non-host can only touch updatedAt (used as a heartbeat).
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.hostUid
        || request.resource.data.diff(resource.data).changedKeys().hasOnly(["updatedAt"])
      );

      allow delete: if false;

      match /players/{uid} {
        allow read: if isSignedIn() && (roomData(roomId).isListed == true || isRoomMember(roomId));

        allow create: if isSignedIn()
          && request.auth.uid == uid
          && roomExists(roomId)
          && roomData(roomId).status in ["lobby", "playing"]
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 14;

        // Player can update own fields; host can reset scores/ready without changing identity fields.
        allow update: if isSignedIn() && (
          (
            request.auth.uid == uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.joinedAt == resource.data.joinedAt
            && request.resource.data.nickname is string
            && request.resource.data.nickname.size() > 0
            && request.resource.data.nickname.size() <= 14
          )
          || (
            isRoomHost(roomId)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.nickname == resource.data.nickname
            && request.resource.data.joinedAt == resource.data.joinedAt
          )
        );

        // Player can leave; host can kick.
        allow delete: if isSignedIn() && (request.auth.uid == uid || isRoomHost(roomId));
      }

      // lobby chat
      match /messages/{messageId} {
        allow read: if isSignedIn() && (roomData(roomId).isListed == true || isRoomMember(roomId));

        allow create: if isSignedIn()
          && isRoomMember(roomId)
          && roomExists(roomId)
          && roomData(roomId).status in ["lobby", "playing"]
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 14
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt is timestamp;

        allow update, delete: if false;
      }
    }

    // posts + comments (community)
    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 2000
        && request.resource.data.imageUrl is string
        && request.resource.data.authorNickname is string
        && request.resource.data.authorPhotoURL is string
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == 0;

      // author can edit; everyone else can only toggle likedBy (no changing content/author)
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.authorUid
        || (
          request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.authorNickname == resource.data.authorNickname
          && request.resource.data.authorPhotoURL == resource.data.authorPhotoURL
          && request.resource.data.title == resource.data.title
          && request.resource.data.body == resource.data.body
          && request.resource.data.imageUrl == resource.data.imageUrl
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.likedBy is list
        )
      );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;

      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && request.resource.data.authorNickname is string
          && request.resource.data.authorPhotoURL is string;

        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
      }
    }
  }
}
